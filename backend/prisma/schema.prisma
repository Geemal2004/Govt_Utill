// Prisma Schema for SQL Server
// This is your Prisma schema file.
// Run `npx prisma db pull` to introspect your existing database
// and generate models automatically.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

